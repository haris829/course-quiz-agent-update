# Copy this file to `.env` and fill in the two values below.
# `.env` is git-ignored. It must never be committed, and never sent anywhere.

# ---------------------------------------------------------------------------
# 1. The database holding the course catalogue
# ---------------------------------------------------------------------------
# Note the port: the development server runs on 5433, not the usual 5432.
# `postgresql+psycopg://...` URLs are accepted as well as `postgresql://...`.
QGEN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/DATABASE

# ---------------------------------------------------------------------------
# 2. The model
# ---------------------------------------------------------------------------
# AWS Bedrock. With no key configured the system refuses cleanly with HTTP 503
# and writes nothing - it never invents questions or answers from nowhere.
COACHING_LLM_PROVIDER=bedrock
COACHING_LLM_API_KEY=
COACHING_LLM_MODEL=arn:aws:bedrock:us-east-1:ACCOUNT:application-inference-profile/PROFILE_ID
COACHING_LLM_REGION=us-east-1

# Optional. Read the model settings from another project's env file rather than
# copying the key into a second place to be forgotten about:
#
#     QGEN_ENV_FILE=/path/to/other/project/backend/.env

# ---------------------------------------------------------------------------
# 3. The course website (optional)
# ---------------------------------------------------------------------------
# Consulted ONLY when the database has no material on a question. `{query}` is
# replaced with the question. Leave empty and the site is never contacted.
#
#   QGEN_SITE_SEARCH=https://example.com/?s={query}
QGEN_SITE_SEARCH=
